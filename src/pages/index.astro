---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { SITE } from "../site";
---

<Base>
	<section class="wrap hero">
		<p class="kicker">{SITE.name}</p>
		<h1>I build tools that keep engineers in charge of their AI agents.</h1>
		<p class="intro">
			After 15 years in infrastructure, I build them in the open and help teams get past the hard part: learning
			to use AI agents well.
		</p>
		<p class="principle">
			Give engineers room to move fast, and put the limits where they protect everyone.
		</p>
		<p class="actions">
			<a class="button" href="/work/">See the open source work</a>
			<a href="/cv/">Read my CV</a>
		</p>
	</section>

	<section class="wrap block" aria-labelledby="beliefs">
		<h2 id="beliefs">What I believe</h2>
		<ul class="beliefs">
			<li>AI has caused a temporal shift.</li>
			<li>Models are great at assumptions. Assumptions aren’t decisions.</li>
			<li>Doing it safely is the hard part.</li>
		</ul>
		<p class="more"><a href="/manifesto/">Read the manifesto</a></p>
	</section>

	<section class="wrap block" aria-labelledby="writing">
		<h2 id="writing">Writing</h2>
		<PostList limit={3} />
	</section>
</Base>

<style>
	.hero {
		padding-block: clamp(3rem, 10vw, 7rem) clamp(2rem, 6vw, 4rem);
	}
	.kicker {
		font-size: var(--step-1);
		font-weight: 600;
		color: var(--muted);
		margin: 0 0 1rem;
	}
	h1 {
		font-size: var(--step-5);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.035em;
		max-width: 21ch;
	}
	.intro {
		font-size: var(--step-2);
		line-height: 1.45;
		color: var(--muted);
		max-width: 34rem;
		margin: 2rem 0 0;
	}
	.principle {
		font-family: var(--serif);
		font-style: italic;
		font-size: var(--step-1);
		color: var(--ink);
		max-width: 34rem;
		margin: 1.25rem 0 0;
		padding-left: 1rem;
		border-left: 3px solid var(--rule);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.75rem;
		margin: 2.5rem 0 0;
	}
	.button {
		display: inline-block;
		background: var(--ink);
		color: var(--on-ink);
		text-decoration: none;
		font-weight: 600;
		line-height: 1.2;
		padding: 0.85rem 1.4rem;
		border-radius: 999px;
		transition: background-color 120ms ease;
	}
	.button:hover {
		background: var(--accent);
	}
	.block {
		margin-top: clamp(3.5rem, 8vw, 6rem);
	}
	h2 {
		font-size: var(--step-3);
		margin-bottom: 1.25rem;
	}
	.beliefs {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
		max-width: 46rem;
	}
	.beliefs li {
		font-size: var(--step-3);
		font-weight: 650;
		line-height: 1.25;
		letter-spacing: -0.015em;
		text-wrap: balance;
		padding-block: 1.25rem;
		border-bottom: 1px solid var(--rule);
	}
	.more {
		margin: 1.25rem 0 0;
		font-weight: 600;
	}
</style>
