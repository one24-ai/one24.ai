---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, formatDate } from "../../posts";

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
	<article class="wrap">
		<header>
			<h1>{post.data.title}</h1>
			<p class="meta">
				<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
				{
					post.data.updated && (
						<>
							, updated <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time>
						</>
					)
				}
			</p>
		</header>
		<div class="prose">
			<Content />
		</div>
		<p class="back"><a href="/writing/">All writing</a></p>
	</article>
</Base>

<style>
	header {
		max-width: 46rem;
		margin: clamp(2rem, 6vw, 4rem) 0 2.5rem;
	}
	h1 {
		font-size: var(--step-4);
	}
	.meta {
		color: var(--muted);
		margin: 1rem 0 0;
	}
	.back {
		margin-top: 3rem;
	}
</style>
