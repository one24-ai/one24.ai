---
// The one24 wordmark: the whole name on a race-red number plate, like a motocross race number.
interface Props {
	size?: "sm" | "lg";
}
const { size = "sm" } = Astro.props;
---

<span class:list={["wordmark", size]} aria-label="one24"
	><span aria-hidden="true"><span class="one">one</span><span class="num">24</span></span></span
>

<style>
	.wordmark {
		display: inline-block;
		font-family: var(--sans);
		letter-spacing: -0.035em;
		line-height: 1;
		white-space: nowrap;
		padding: 0.14em 0.36em 0.18em;
		background: var(--plate);
		color: var(--plate-text);
		border-radius: 0.24em 0.24em 0.46em 0.46em;
	}
	.one {
		font-weight: 550;
	}
	.num {
		font-weight: 850;
	}
	.sm {
		font-size: 1.375rem;
	}
	.lg {
		font-size: 3rem;
	}
	@media print {
		.wordmark {
			-webkit-print-color-adjust: exact;
			print-color-adjust: exact;
		}
	}
</style>
