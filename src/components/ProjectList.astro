---
import { getCollection } from "astro:content";

interface Props {
	kind: "pi-package" | "project";
}
const { kind } = Astro.props;
const projects = (await getCollection("projects", ({ data }) => data.kind === kind)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<ul class="projects">
	{
		projects.map(({ data }) => (
			<li>
				<h3>
					{data.repo ? <a href={data.repo}>{data.name}</a> : data.name}
				</h3>
				<p class="status">
					{data.status === "released" ? `v${data.version}` : "In design"}
				</p>
				<p class="summary">{data.summary}</p>
			</li>
		))
	}
</ul>

<style>
	.projects {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--rule);
	}
	li {
		display: grid;
		grid-template-columns: 11rem 1fr;
		grid-template-rows: auto 1fr;
		align-items: start;
		grid-template-areas:
			"name summary"
			"status summary";
		column-gap: 2rem;
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--rule);
	}
	h3 {
		grid-area: name;
		font-size: var(--step-2);
	}
	h3 a {
		color: var(--ink);
		text-decoration: none;
	}
	h3 a:hover {
		color: var(--accent);
		text-decoration: underline;
	}
	.status {
		grid-area: status;
		margin: 0.35rem 0 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.summary {
		grid-area: summary;
		margin: 0;
		max-width: 36rem;
		color: var(--ink);
	}
	@media (max-width: 40rem) {
		li {
			grid-template-columns: 1fr;
			grid-template-areas: "name" "status" "summary";
		}
		.summary {
			margin-top: 0.75rem;
		}
	}
</style>
