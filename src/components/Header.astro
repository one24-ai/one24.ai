---
import Wordmark from "./Wordmark.astro";
import { NAV } from "../site";

const path = Astro.url.pathname;
---

<header class="wrap site-header">
	<a href="/" class="home" aria-label="one24, home"><Wordmark /></a>
	<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="main-menu" hidden>
		<span class="bars" aria-hidden="true"></span>
		<span class="label">Menu</span>
	</button>
	<nav id="main-menu" aria-label="Main">
		<ul>
			{
				NAV.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={path.startsWith(href) ? "page" : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<script>
	// Progressive enhancement: without JavaScript the menu stays a plain, always-visible list.
	const header = document.querySelector<HTMLElement>(".site-header");
	const toggle = header?.querySelector<HTMLButtonElement>(".menu-toggle");
	if (header && toggle) {
		header.dataset.js = "";
		toggle.hidden = false;
		const setOpen = (open: boolean) => {
			toggle.setAttribute("aria-expanded", String(open));
			header.toggleAttribute("data-open", open);
		};
		toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && header.hasAttribute("data-open")) {
				setOpen(false);
				toggle.focus();
			}
		});
	}
</script>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1.75rem;
	}
	.home {
		text-decoration: none;
	}
	ul {
		display: flex;
		flex-wrap: wrap; /* no-JavaScript fallback on narrow screens */
		gap: 0.5rem clamp(1rem, 3vw, 2rem);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		font-weight: 500;
	}
	nav a:hover {
		color: var(--ink);
	}
	nav a[aria-current="page"] {
		color: var(--ink);
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}
	.menu-toggle {
		display: none;
	}

	/* Phones: the menu collapses behind a button (only when JavaScript is running). */
	@media (max-width: 40rem) {
		.site-header[data-js] {
			flex-wrap: wrap;
			align-items: center;
		}
		/* Icon only, with a 44px tap target; the label is for screen readers. */
		.site-header[data-js] .menu-toggle {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.75rem;
			height: 2.75rem;
			margin-right: -0.6rem;
			padding: 0;
			color: var(--ink);
			background: none;
			border: 0;
			cursor: pointer;
		}
		@media (hover: hover) {
			.site-header[data-js] .menu-toggle:hover {
				color: var(--accent);
			}
		}
		.label {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
		.bars,
		.bars::before,
		.bars::after {
			display: block;
			width: 1.375rem;
			height: 2px;
			background: currentColor;
			border-radius: 1px;
		}
		.bars {
			position: relative;
		}
		.bars::before,
		.bars::after {
			content: "";
			position: absolute;
			left: 0;
		}
		.bars::before {
			top: -7px;
		}
		.bars::after {
			top: 7px;
		}
		.site-header[data-open] .bars {
			background: transparent;
		}
		.site-header[data-open] .bars::before {
			top: 0;
			transform: rotate(45deg);
		}
		.site-header[data-open] .bars::after {
			top: 0;
			transform: rotate(-45deg);
		}
		.site-header[data-js] nav {
			display: none;
			flex-basis: 100%;
		}
		.site-header[data-open] nav {
			display: block;
		}
		.site-header[data-js] ul {
			flex-direction: column;
			gap: 0;
			border-top: 1px solid var(--rule);
		}
		.site-header[data-js] li {
			border-bottom: 1px solid var(--rule);
		}
		.site-header[data-js] li a {
			display: block;
			padding-block: 0.85rem;
			font-size: var(--step-1);
		}
	}

	@media print {
		.menu-toggle {
			display: none !important;
		}
	}
</style>
